
#!/bin/bash
# ==========================================================
# TECH NET VPN - INSTALADOR PRINCIPAL
# Instala diretamente do GitHub em VPS limpa
# Suporte: Ubuntu/Debian - x86_64 e ARM64
# ==========================================================

set -Eeuo pipefail

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
SCOLOR='\033[0m'

REPO="https://github.com/Luciliosantos/TECH-NET-VPN"
BRANCH="main"
PANEL_REPO="https://raw.githubusercontent.com/Luciliosantos/TECH-NET-VPN/main"
ARCHIVE_URL="https://codeload.github.com/Luciliosantos/TECH-NET-VPN/tar.gz/refs/heads/${BRANCH}"

INSTALL_DIR="/opt/technetvpn-installer"

msg() {
    echo -e "${BLUE}[TECH NET VPN]${SCOLOR} $1"
}

erro() {
    echo -e "${RED}[ERRO]${SCOLOR} $1" >&2
    exit 1
}

aviso() {
    echo -e "${YELLOW}[AVISO]${SCOLOR} $1"
}

sucesso() {
    echo -e "${GREEN}[OK]${SCOLOR} $1"
}

# ----------------------------------------------------------
# ROOT
# ----------------------------------------------------------

if [[ "$EUID" -ne 0 ]]; then
    erro "Execute este instalador como ROOT."
fi

# ----------------------------------------------------------
# ARQUITETURA
# ----------------------------------------------------------

case "$(uname -m)" in
    x86_64|amd64)
        arch="64"
        ;;
    aarch64|arm64)
        arch="arm64"
        ;;
    *)
        erro "Arquitetura não suportada: $(uname -m)"
        ;;
esac

msg "Arquitetura identificada: $arch"

# ----------------------------------------------------------
# SISTEMA OPERACIONAL
# ----------------------------------------------------------

if [[ ! -f /etc/os-release ]]; then
    erro "Não foi possível identificar o sistema operacional."
fi

. /etc/os-release

case "${ID:-}" in
    ubuntu)
        if ! dpkg --compare-versions "${VERSION_ID:-0}" ge "18.04"; then
            erro "Ubuntu 18.04 ou superior é necessário."
        fi
        ;;
    debian)
        DEBIAN_VERSION="${VERSION_ID%%.*}"

        if ! [[ "$DEBIAN_VERSION" =~ ^[0-9]+$ ]] ||
           (( DEBIAN_VERSION < 9 )); then
            erro "Debian 9 ou superior é necessário."
        fi
        ;;
    *)
        erro "Sistema não suportado: ${PRETTY_NAME:-desconhecido}. Use Ubuntu ou Debian."
        ;;
esac

sucesso "Sistema identificado: ${PRETTY_NAME:-$ID}"

# ----------------------------------------------------------
# DEPENDÊNCIAS
# ----------------------------------------------------------

export DEBIAN_FRONTEND=noninteractive

msg "Preparando o sistema..."

if ! dpkg --configure -a; then
    erro "Falha ao configurar pacotes pendentes do sistema."
fi

if ! apt-get update; then
    erro "Falha ao atualizar a lista de pacotes. Verifique a conexão e os repositórios APT."
fi

if ! apt-get install -y \
    ca-certificates \
    curl \
    wget \
    tar \
    gzip \
    unzip \
    python3; then
    erro "Não foi possível instalar as dependências necessárias."
fi

sucesso "Dependências instaladas."

# ----------------------------------------------------------
# IPV6
# Mantém o comportamento do instalador original.
# ----------------------------------------------------------

msg "Configurando rede..."

if command -v sysctl >/dev/null 2>&1; then
    sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1 || true

    mkdir -p /etc/sysctl.d

    echo 'net.ipv6.conf.all.disable_ipv6 = 1' \
        > /etc/sysctl.d/70-disable-ipv6.conf

    sysctl -p /etc/sysctl.d/70-disable-ipv6.conf \
        >/dev/null 2>&1 || true
fi

# ----------------------------------------------------------
# DOWNLOAD COMPLETO DO GITHUB
# ----------------------------------------------------------

msg "Preparando download do repositório..."

WORK_DIR="$(mktemp -d /opt/.technetvpn-install.XXXXXX)" ||
    erro "Não foi possível criar diretório temporário em /opt."

cleanup() {
    if [[ -n "${WORK_DIR:-}" && -d "$WORK_DIR" ]]; then
        rm -rf -- "$WORK_DIR"
    fi
}

trap cleanup EXIT

ARCHIVE="$WORK_DIR/technetvpn.tar.gz"
SOURCE_DIR="$WORK_DIR/source"

mkdir -p "$SOURCE_DIR"

msg "Baixando projeto completo do GitHub..."

DOWNLOAD_OK=0

if curl -fL \
    --retry 3 \
    --retry-delay 2 \
    --connect-timeout 20 \
    --max-time 600 \
    -o "$ARCHIVE" \
    "$ARCHIVE_URL"; then
    DOWNLOAD_OK=1
else
    aviso "Download pelo curl falhou. Tentando pelo wget..."
fi

if [[ "$DOWNLOAD_OK" -ne 1 ]]; then
    if wget \
        --tries=3 \
        --timeout=30 \
        -O "$ARCHIVE" \
        "$ARCHIVE_URL"; then
        DOWNLOAD_OK=1
    fi
fi

if [[ "$DOWNLOAD_OK" -ne 1 || ! -s "$ARCHIVE" ]]; then
    erro "Não foi possível baixar o projeto do GitHub. Verifique a conexão com github.com."
fi

# ----------------------------------------------------------
# VALIDAÇÃO DO ARQUIVO
# ----------------------------------------------------------

msg "Validando pacote baixado..."

if ! tar -tzf "$ARCHIVE" >/dev/null 2>&1; then
    erro "O arquivo recebido do GitHub não é um pacote válido."
fi

if ! tar -tzf "$ARCHIVE" |
    grep -Eq '^[^/]+/script/'"$arch"'/Plus$'; then
    erro "O instalador script/$arch/Plus não foi encontrado no repositório."
fi

if ! tar -tzf "$ARCHIVE" |
    grep -Eq '^[^/]+/Install/list$'; then
    erro "O arquivo Install/list não foi encontrado no repositório."
fi

# ----------------------------------------------------------
# EXTRAÇÃO
# ----------------------------------------------------------

msg "Extraindo arquivos do projeto..."

if ! tar -xzf "$ARCHIVE" \
    --strip-components=1 \
    -C "$SOURCE_DIR"; then
    erro "Falha ao extrair o projeto."
fi

PLUS_FILE="$SOURCE_DIR/script/$arch/Plus"

if [[ ! -s "$PLUS_FILE" ]]; then
    erro "O arquivo principal Plus está vazio ou ausente."
fi

if [[ ! -s "$SOURCE_DIR/Install/list" ]]; then
    erro "Install/list está vazio ou ausente."
fi

if ! bash -n "$PLUS_FILE"; then
    erro "O arquivo script/$arch/Plus contém erro de sintaxe."
fi

if ! bash -n "$SOURCE_DIR/Install/list"; then
    erro "O arquivo Install/list contém erro de sintaxe."
fi

chmod +x "$PLUS_FILE" "$SOURCE_DIR/Install/list"

sucesso "Projeto completo baixado e validado."

# ----------------------------------------------------------
# INSTALAÇÃO PERMANENTE DA FONTE
# ----------------------------------------------------------

msg "Preparando diretório do instalador..."

mkdir -p "$(dirname "$INSTALL_DIR")"

# Preserva uma cópia anterior, caso exista.
if [[ -e "$INSTALL_DIR" ]]; then
    BACKUP_DIR="${INSTALL_DIR}.backup.$(date +%Y%m%d%H%M%S)"

    if ! mv "$INSTALL_DIR" "$BACKUP_DIR"; then
        erro "Não foi possível preservar a instalação anterior."
    fi

    aviso "Cópia anterior preservada em: $BACKUP_DIR"
fi

if ! mv "$SOURCE_DIR" "$INSTALL_DIR"; then
    erro "Não foi possível preparar os arquivos do instalador."
fi

PLUS_FILE="$INSTALL_DIR/script/$arch/Plus"

if [[ ! -s "$INSTALL_DIR/Install/list" ||
      ! -s "$PLUS_FILE" ]]; then
    erro "A validação final dos arquivos falhou."
fi

chmod +x "$PLUS_FILE" "$INSTALL_DIR/Install/list"

# Informa ao Plus a localização da fonte.
export PANEL_SOURCE_DIR="$INSTALL_DIR"
export PANEL_REPO

sucesso "Arquivos disponíveis em $INSTALL_DIR"

# ----------------------------------------------------------
# EXECUÇÃO DO INSTALADOR
# ----------------------------------------------------------

msg "Iniciando instalação TECH NET VPN..."

cd "$INSTALL_DIR"

if bash "$PLUS_FILE"; then
    sucesso "O instalador principal foi executado."
else
    RESULTADO=$?
    erro "O instalador Plus terminou com erro (código $RESULTADO)."
fi
