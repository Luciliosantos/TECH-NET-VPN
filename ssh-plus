
#!/bin/bash
# ==========================================================
# TECH NET VPN - INSTALADOR PRINCIPAL
# Download completo diretamente do GitHub
# Ubuntu / Debian - x86_64 / ARM64
# ==========================================================

set -Eeuo pipefail

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
NC='\033[0m'

REPO="https://github.com/Luciliosantos/TECH-NET-VPN"
BRANCH="main"
ARCHIVE_URL="https://codeload.github.com/Luciliosantos/TECH-NET-VPN/tar.gz/refs/heads/${BRANCH}"
INSTALL_DIR="/opt/technetvpn-installer"

msg() {
    echo -e "${BLUE}[TECH NET VPN]${NC} $1"
}

ok() {
    echo -e "${GREEN}[OK]${NC} $1"
}

fail() {
    echo -e "${RED}[ERRO]${NC} $1" >&2
    exit 1
}

warn() {
    echo -e "${YELLOW}[AVISO]${NC} $1"
}

# ==========================================================
# ROOT
# ==========================================================

if [[ "$EUID" -ne 0 ]]; then
    fail "Execute o instalador como ROOT."
fi

clear 2>/dev/null || true

# ==========================================================
# ARQUITETURA
# ==========================================================

case "$(uname -m)" in
    x86_64|amd64)
        ARCH="64"
        ;;
    aarch64|arm64)
        ARCH="arm64"
        ;;
    *)
        fail "Arquitetura não suportada: $(uname -m)"
        ;;
esac

msg "Arquitetura identificada: $ARCH"

# ==========================================================
# SISTEMA OPERACIONAL
# ==========================================================

if [[ ! -f /etc/os-release ]]; then
    fail "Não foi possível identificar o sistema operacional."
fi

. /etc/os-release

case "${ID:-}" in
    ubuntu)
        if ! dpkg --compare-versions "${VERSION_ID:-0}" ge "18.04"; then
            fail "É necessário Ubuntu 18.04 ou superior."
        fi
        ;;
    debian)
        DEBIAN_VERSION="${VERSION_ID%%.*}"

        if ! [[ "$DEBIAN_VERSION" =~ ^[0-9]+$ ]] ||
           (( DEBIAN_VERSION < 9 )); then
            fail "É necessário Debian 9 ou superior."
        fi
        ;;
    *)
        fail "Sistema não suportado. Utilize Ubuntu ou Debian."
        ;;
esac

ok "Sistema identificado: ${PRETTY_NAME:-$ID}"

# ==========================================================
# DEPENDÊNCIAS
# ==========================================================

export DEBIAN_FRONTEND=noninteractive

msg "Preparando o sistema..."

if ! dpkg --configure -a; then
    fail "Existem pacotes pendentes com erro no sistema."
fi

if ! apt-get update; then
    fail "Falha ao atualizar os repositórios APT."
fi

if ! apt-get install -y \
    ca-certificates \
    curl \
    wget \
    tar \
    gzip \
    unzip \
    python3; then
    fail "Não foi possível instalar as dependências básicas."
fi

ok "Dependências básicas instaladas."

# ==========================================================
# DIRETÓRIO TEMPORÁRIO
# ==========================================================

mkdir -p /opt

WORK_DIR="$(mktemp -d /opt/.technetvpn.XXXXXX)" ||
    fail "Não foi possível criar diretório temporário."

cleanup() {
    if [[ -n "${WORK_DIR:-}" && -d "$WORK_DIR" ]]; then
        rm -rf -- "$WORK_DIR"
    fi
}

trap cleanup EXIT

ARCHIVE="$WORK_DIR/project.tar.gz"
SOURCE_DIR="$WORK_DIR/source"

mkdir -p "$SOURCE_DIR"

# ==========================================================
# DOWNLOAD DO REPOSITÓRIO COMPLETO
# ==========================================================

msg "Baixando o projeto completo do GitHub..."

DOWNLOAD_OK=0

if curl -fL \
    --retry 3 \
    --retry-delay 2 \
    --connect-timeout 20 \
    --max-time 600 \
    -o "$ARCHIVE" \
    "$ARCHIVE_URL"; then
    DOWNLOAD_OK=1
else
    warn "Download pelo curl falhou. Tentando pelo wget..."
fi

if [[ "$DOWNLOAD_OK" -ne 1 ]]; then
    if wget \
        --tries=3 \
        --timeout=30 \
        -O "$ARCHIVE" \
        "$ARCHIVE_URL"; then
        DOWNLOAD_OK=1
    fi
fi

if [[ "$DOWNLOAD_OK" -ne 1 || ! -s "$ARCHIVE" ]]; then
    fail "Falha ao baixar o repositório. Verifique a conexão com o GitHub."
fi

# ==========================================================
# VALIDAR PACOTE
# ==========================================================

msg "Validando arquivos recebidos..."

if ! tar -tzf "$ARCHIVE" >/dev/null 2>&1; then
    fail "O arquivo recebido não é um pacote TAR válido."
fi

if ! tar -tzf "$ARCHIVE" |
    grep -Eq '^[^/]+/script/'"$ARCH"'/Plus$'; then
    fail "Não foi encontrado script/$ARCH/Plus no GitHub."
fi

if ! tar -tzf "$ARCHIVE" |
    grep -Eq '^[^/]+/Install/list$'; then
    fail "Não foi encontrado Install/list no GitHub."
fi

# ==========================================================
# EXTRAÇÃO
# ==========================================================

msg "Extraindo o projeto..."

if ! tar -xzf "$ARCHIVE" \
    --strip-components=1 \
    -C "$SOURCE_DIR"; then
    fail "Falha ao extrair os arquivos."
fi

PLUS_FILE="$SOURCE_DIR/script/$ARCH/Plus"
LIST_FILE="$SOURCE_DIR/Install/list"

if [[ ! -s "$PLUS_FILE" ]]; then
    fail "O arquivo Plus está ausente ou vazio."
fi

if [[ ! -s "$LIST_FILE" ]]; then
    fail "O arquivo Install/list está ausente ou vazio."
fi

if ! bash -n "$PLUS_FILE"; then
    fail "Erro de sintaxe no script/$ARCH/Plus."
fi

if ! bash -n "$LIST_FILE"; then
    fail "Erro de sintaxe no Install/list."
fi

chmod +x "$PLUS_FILE" "$LIST_FILE"

ok "Arquivos principais validados."

# ==========================================================
# PREPARAR DIRETÓRIO DEFINITIVO
# ==========================================================

msg "Preparando os arquivos do instalador..."

BACKUP_DIR=""

if [[ -e "$INSTALL_DIR" ]]; then
    BACKUP_DIR="${INSTALL_DIR}.backup.$(date +%Y%m%d%H%M%S)"

    if ! mv "$INSTALL_DIR" "$BACKUP_DIR"; then
        fail "Não foi possível preservar a instalação anterior."
    fi

    warn "Versão anterior preservada em $BACKUP_DIR"
fi

if ! mv "$SOURCE_DIR" "$INSTALL_DIR"; then
    if [[ -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]]; then
        mv "$BACKUP_DIR" "$INSTALL_DIR" || true
    fi
    fail "Não foi possível preparar o diretório do projeto."
fi

PLUS_FILE="$INSTALL_DIR/script/$ARCH/Plus"
LIST_FILE="$INSTALL_DIR/Install/list"

if [[ ! -s "$PLUS_FILE" || ! -s "$LIST_FILE" ]]; then
    fail "Falha na verificação final dos arquivos."
fi

chmod +x "$PLUS_FILE" "$LIST_FILE"

# ==========================================================
# INFORMAR ORIGEM AO INSTALADOR
# ==========================================================

export PANEL_SOURCE_DIR="$INSTALL_DIR"
export PANEL_REPO="https://raw.githubusercontent.com/Luciliosantos/TECH-NET-VPN/main"

mkdir -p /etc/technetvpn

printf '%s\n' "$INSTALL_DIR" > /etc/technetvpn/source_dir

ok "Projeto preparado em $INSTALL_DIR"

# ==========================================================
# EXECUTAR INSTALADOR DA ARQUITETURA
# ==========================================================

msg "Iniciando instalador para arquitetura $ARCH..."

cd "$INSTALL_DIR"

set +e
bash "$PLUS_FILE"
RESULTADO=$?
set -e

if [[ "$RESULTADO" -ne 0 ]]; then
    fail "O instalador Plus terminou com erro. Código: $RESULTADO"
fi

ok "Execução do instalador Plus finalizada."
