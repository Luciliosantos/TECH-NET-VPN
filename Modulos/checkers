#!/bin/bash
# CHECKUSER — TECH NET VPN
# CORRIGIDO (v1.2.1): menu padronizado TNUi. As opcoes 2-4 continuam
# disponiveis como ADDONS EXTERNOS opcionais (repositorios de terceiros
# do ecossistema checkuser) — agora com aviso explicito antes de baixar.
[[ -f /bin/tnui ]] && source /bin/tnui

_addon_ext () {
    tn_info "Este item baixa um addon EXTERNO de terceiros ($1)."
    echo -e " ${TN_C_M}O painel local não é afetado; a fonte pode ficar offline.${TN_R}"
    echo -ne " ${TN_C_C}➤${TN_R} ${TN_C_N}Continuar com o download? [s/n] :${TN_R} "
    read r
    [[ "$r" == "s" || "$r" == "S" ]]
}

while true
do
    clear
    tn_logo
    tn_box_top "MENU CHECKUSER"
    tn_item "01" "Checkuser Conecta4G (local)" "" "02" "Checkuser DTunnel VPN" ""
    tn_item "03" "Checkuser GL Tunnel VPN" "" "04" "Checkuser AnyVPN MOD" ""
    tn_item "00" "« Voltar" "" "" "" ""
    tn_box_end
    tn_prompt; read x
    case "$x" in
    1|01) clear; initcheck ;;
    2|02) clear; _addon_ext "ScottBrabo/DTunnel" && bash <(curl -sL https://raw.githubusercontent.com/ScottBrabo/DTunnel/main/MenuDT.sh) ;;
    3|03) clear; _addon_ext "ScottBrabo/CheckUser" && bash <(curl -sL https://raw.githubusercontent.com/ScottBrabo/CheckUser/master/install.sh) ;;
    4|04) clear; _addon_ext "ScottBrabo/AnyChk" && bash <(wget -qO- https://raw.githubusercontent.com/ScottBrabo/DTunnel/main/AnyChk) ;;
    0|00) clear; menu ;;
    *) tn_erro "Opção inválida !"; sleep 2 ;;
    esac
done
