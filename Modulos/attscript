#!/bin/bash
# ATUALIZAR SCRIPT — TECH NET VPN
# CORRIGIDO (v1.2.1): o fluxo antigo baixava arquivos do repositorio
# GitHub antigo (Luciliosantos/TECH-NET-VPN) e do Dropbox do antigo
# dono, SUBSCREVENDO os arquivos corrigidos por versoes velhas (o
# repositorio esta OFFLINE, entao alem de perigoso o update falhava).
# Agora a atualizacao usa SOMENTE o projeto local salvo no VPS
# (registrado pelo instalador em /etc/technetvpn/source_dir).
clear
[[ "$(whoami)" != "root" ]] && {
    echo -e "\033[1;33m[\033[1;31mErro\033[1;33m] \033[1;37m- \033[1;33mvocê precisa executar como root\033[0m"
    exit 0
}
[[ -f /bin/tnui ]] && source /bin/tnui

SRC=$(cat /etc/technetvpn/source_dir 2>/dev/null)
if [[ -z "$SRC" || ! -f "$SRC/Install/list" ]]; then
    SRC=$(dirname "$(readlink -f "$0")"); [[ -f "$SRC/Install/list" ]] || SRC=""
fi
if [[ -z "$SRC" ]]; then
    tn_erro "Projeto local não encontrado neste VPS."
    echo -e " ${TN_C_M}Extraia o ZIP atualizado do painel (ex.: em /root/TECH-NET-VPN) e rode${TN_R}"
    echo -e " ${TN_C_M}novamente o instalador ssh-plus a partir da pasta extraida para atualizar.${TN_R}"
    sleep 4; menu
fi

_vl_inst=$(sed -n '1p' /bin/versao 2>/dev/null | tr -dc '0-9'); [[ -z "$_vl_inst" ]] && _vl_inst="?"
_vl_proj=$(sed -n '1p' "$SRC/Modulos/versao" 2>/dev/null | tr -dc '0-9'); [[ -z "$_vl_proj" ]] && _vl_proj="?"

tn_logo
tn_box_top "ATUALIZAR SCRIPT"
tn_linec "${TN_C_M}Projeto local:${TN_R} ${TN_C_N}$SRC${TN_R}"
tn_linec "${TN_C_M}Versão instalada:${TN_R} ${TN_C_N}$_vl_inst${TN_R}    ${TN_C_M}Versão do projeto:${TN_R} ${TN_C_N}$_vl_proj${TN_R}"
tn_box_bar
echo -ne " ${TN_C_C}➤${TN_R} ${TN_C_N}Atualizar o painel a partir do projeto local? [s/n] :${TN_R} "
read r
[[ "$r" == "s" || "$r" == "S" ]] || { tn_info "Operação cancelada."; sleep 2; menu; }

_atlz () {
    local ok=0 fail=0 f
    _lista=$(sed -n 's/^_mdls=(\(.*\))$/\1/p' "$SRC/Install/list" | tr '"' ' ')
    for f in $_lista; do
        if [[ -f "$SRC/Modulos/$f" ]]; then
            if cp -f "$SRC/Modulos/$f" "/bin/$f" && chmod +x "/bin/$f" 2>/dev/null; then ok=$((ok+1)); else fail=$((fail+1)); fi
        fi
    done
    for f in open.py proxy.py wsproxy.py ShellBot.sh; do
        [[ -f "$SRC/Modulos/$f" ]] && cp -f "$SRC/Modulos/$f" /etc/SSHPlus/ && chmod +x "/etc/SSHPlus/$f" && ok=$((ok+1))
    done
    [[ -f "$SRC/Modulos/WebSocket" ]] && cp -f "$SRC/Modulos/WebSocket" /etc/SSHPlus/ && chmod +x /etc/SSHPlus/WebSocket
    [[ -f "$SRC/Modulos/pub.key" ]] && cp -f "$SRC/Modulos/pub.key" /etc/SSHPlus/
    [[ -f "$SRC/Modulos/priv.pem" ]] && cp -f "$SRC/Modulos/priv.pem" /etc/SSHPlus/
    [[ -f "$SRC/Modulos/proxydt" ]] && cp -f "$SRC/Modulos/proxydt" /etc/SSHPlus/ && chmod +x /etc/SSHPlus/proxydt
    [[ -f "$SRC/Modulos/versao" ]] && cp -f "$SRC/Modulos/versao" /bin/versao
    echo "$ok|$fail"
}

RES=$(_atlz 2>/dev/null)
_ok=${RES%%|*}; _fail=${RES##*|}
echo ""
if [[ "$_fail" == "0" && "$_ok" -gt 0 ]]; then
    tn_ok "Painel atualizado (${_ok} arquivos) — versão $_vl_proj."
else
    tn_erro "Atualização concluída com ${_fail} falha(s) — verifique os caminhos do projeto."
fi
echo -e " ${TN_C_M}Comando principal:${TN_R} ${TN_C_N}menu${TN_R}"
echo ""
echo -ne " ${TN_C_M}ENTER para retornar ao MENU${TN_R} "; read
menu
