   tn_width
   clear
   if [[ $TN_W -ge 72 ]]; then
      echo -e "${TN_C_B}▀█▀ █▀█ █▀█ █▀▄   █▀█ █▄█ ▄▀█ ▀█▀ █ █▄█ █▀█ █▀▄▀█${TN_R}"
      echo -e "${TN_C_C} █  █ █ █ █▀▄   █ █ █ █ █▀█  █  █ █ █ █ █▀ █ ▀█${TN_R}"
      echo -e "${TN_C_C} ▀  ▀▀▀ ▀▀   ▀▀   ▀ ▀ ▀ ▀▀▀▀  ▀  ▀▀ ▀ ▀ ▀ ▀   ▀${TN_R}"
   else
      echo -e "${TN_C_B}▀█▀▄▀█ █▀█ █▀▀█ ▀█▀█▀▀█ █▄─█ █▄█ █▀▀▄ █▀▀▄▀█${TN_R}"
      echo -e "${TN_C_C} █ █ █ █▄█ █▄▄▀  █  █▄▄█ █ ▀█ █─░█ █▄▄▀ █ ▀█${TN_R}"
   fi
   if [[ $TN_W -ge 56 ]]; then
      echo -e "${TN_C_M}$(tn_pad "PAINEL DE CONTROLE • CONECTIVIDADE SEM LIMITES" $TN_W c)${TN_R}"
   else
      echo -e "${TN_C_M}$(tn_pad "PAINEL DE CONTROLE" $TN_W c)${TN_R}"
   fi
}

# ---- quadros ----------------------------------------------
tn_box_top () { # linha superior com título (largura total TN_W)
   local titulo="$1"
   tn_width
   echo -e "${TN_C_D}╭─${TN_R}${TN_C_N} ${titulo} ${TN_R}${TN_C_D}$(tn_rep $(( TN_W - ${#titulo} - 5 )))╮${TN_R}"
}
tn_box_sep () { # separador de seção com rótulo
   local titulo="$1"
   tn_width
   echo -e "${TN_C_D}├─${TN_R}${TN_C_C} ${titulo} ${TN_R}${TN_C_D}$(tn_rep $(( TN_W - ${#titulo} - 5 )))┤${TN_R}"
}
tn_box_bar () {
   tn_width
   echo -e "${TN_C_D}│$(tn_rep $(( TN_W - 2 )))│${TN_R}"
}
tn_box_end () {
   tn_width
   echo -e "${TN_C_D}╰$(tn_rep $(( TN_W - 2 )))╯${TN_R}"
}
tn_line () { # linha alinhada à esquerda dentro do quadro
   tn_width
   local v; v=$(tn_vis "$1"); if [[ ${#v} -gt $((TN_W-4)) ]]; then
      echo -e "${TN_C_D}│${TN_R} $(tn_pad "$(tn_cut "$1" $((TN_W-4)))" $((TN_W-4))) ${TN_C_D}│${TN_R}"; return 0; fi
   echo -e "${TN_C_D}│${TN_R} $(tn_pad "$1" $(( TN_W - 4 ))) ${TN_C_D}│${TN_R}"
}
tn_linec () { # linha centralizada dentro do quadro
   tn_width
   local v; v=$(tn_vis "$1"); if [[ ${#v} -gt $((TN_W-2)) ]]; then
      echo -e "${TN_C_D}│${TN_R}$(tn_pad "$(tn_cut "$1" $((TN_W-2)))" $((TN_W-2)) c)${TN_C_D}│${TN_R}"; return 0; fi
   echo -e "${TN_C_D}│${TN_R}$(tn_pad "$1" $(( TN_W - 2 )) c)${TN_C_D}│${TN_R}"
}

# ---- cartões de indicadores --------------------------------
# tn_cards "ROTULO:VALOR" ...  (largura total = TN_W)
tn_cards () {
   # divide os cartões em linhas que caibam na largura do terminal
   local per=$(( (TN_W - 3) / 11 )); (( per < 1 )) && per=1
   local args=("$@") total=$# i j chunk
   for (( i=0; i<total; i+=per )); do
      chunk=()
      for (( j=i; j<i+per && j<total; j++ )); do chunk+=("${args[$j]}"); done
      _tn_cards_row "${chunk[@]}"
   done
}
_tn_cards_row () {
   local item n cw extra i t out
   n=$#
   (( n == 0 )) && return 0
   cw=$(( (TN_W - 3 - 3*n) / n )); (( cw < 7 )) && cw=7
   extra=$(( TN_W - (3 + n*(cw+3)) )); (( extra < 0 )) && extra=0
   local -a wd=()
   for (( i=0; i<n; i++ )); do
      if (( extra > 0 )); then wd[$i]=$(( cw+1 )); extra=$((extra-1)); else wd[$i]=$cw; fi
   done
   out="${TN_C_D}│${TN_R} "
   for (( i=0; i<n; i++ )); do out+="${TN_C_D}╭$(tn_rep ${wd[$i]})╮${TN_R} "; done
   echo -e "$out${TN_C_D}│${TN_R}"
   out="${TN_C_D}│${TN_R} "
   i=0
   for item in "$@"; do
      t="${item%%:*}"
      out+="${TN_C_D}│${TN_R}$(tn_pad "${TN_C_C}${t}${TN_R}" ${wd[$i]})${TN_C_D}│${TN_R} "
      i=$((i+1))
   done
   echo -e "$out${TN_C_D}│${TN_R}"
   out="${TN_C_D}│${TN_R} "
   i=0
   for item in "$@"; do
      t="${item#*:}"
      out+="${TN_C_D}│${TN_R}$(tn_pad "${TN_C_N}${t}${TN_R}" ${wd[$i]})${TN_C_D}│${TN_R} "
      i=$((i+1))
   done
   echo -e "$out${TN_C_D}│${TN_R}"
   out="${TN_C_D}│${TN_R} "
   for (( i=0; i<n; i++ )); do out+="${TN_C_D}╰$(tn_rep ${wd[$i]})╯${TN_R} "; done
   echo -e "$out${TN_C_D}│${TN_R}"
}

# ---- chips de status ---------------------------------------
tn_on   () { echo -ne "${TN_C_G}● ON${TN_R}"; }
tn_off  () { echo -ne "${TN_C_R}○ OFF${TN_R}"; }
tn_wait () { echo -ne "${TN_C_Y}◐ AGUARDANDO${TN_R}"; }

# tn_svc: status REAL do servico. $1 = padrao de processo; $2 = porta TCP
# opcional. Retorna: 1 = processo ativo E porta escutando; 0 = nada ativo;
# 2 = processo existe MAS a porta nao escuta (estado inconclusivo).
tn_svc () {
   local pat="$1" port="$2"
   pgrep -f "$pat" >/dev/null 2>&1 || { echo 0; return; }
   if [[ -n "$port" ]]; then
      if ss -H -tln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}$"; then
         echo 1
      else
         echo 2
      fi
   else
      echo 1
   fi
}
# tn_svc_udp: idem para porta UDP (nao ha estado LISTEN em udp)
tn_svc_udp () {
   local pat="$1" port="$2"
   pgrep -f "$pat" >/dev/null 2>&1 || { echo 0; return; }
   if [[ -n "$port" ]] && ss -H -uln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]${port}$"; then
      echo 1
   else
      echo 2
   fi
}

# ---- item de menu ------------------------------------------
# tn_item num rotulo status(1|0|"") [num2 rotulo2 status2]
tn_item () {
   local num="$1" label="$2" st="$3" num2="$4" label2="$5" st2="$6"
   tn_width
   local l r lv rv gap pad
   l=" ${TN_C_D}[${TN_R}${TN_C_Y}$(tn_pad "$num" 2 r)${TN_R}${TN_C_D}]${TN_R} ${TN_C_M}${label}${TN_R}"
   if [[ "$st" == "1" ]]; then l+=" ${TN_C_G}●${TN_R}"; elif [[ "$st" == "2" ]]; then l+=" ${TN_C_Y}◐${TN_R}"; elif [[ "$st" == "0" ]]; then l+=" ${TN_C_R}○${TN_R}"; fi
   if [[ -n "$num2" && $TN_W -ge 62 ]]; then
      r="${TN_C_D}[${TN_R}${TN_C_Y}$(tn_pad "$num2" 2 r)${TN_R}${TN_C_D}]${TN_R} ${TN_C_M}${label2}${TN_R}"
      if [[ "$st2" == "1" ]]; then r+=" ${TN_C_G}●${TN_R}"; elif [[ "$st2" == "2" ]]; then r+=" ${TN_C_Y}◐${TN_R}"; elif [[ "$st2" == "0" ]]; then r+=" ${TN_C_R}○${TN_R}"; fi
      lv=$(tn_vis "$l"); rv=$(tn_vis "$r")
      gap=$(( (TN_W - 6) / 2 - ${#lv} )); (( gap < 1 )) && gap=1
      pad=$(( TN_W - 2 - ${#lv} - ${#rv} - gap )); (( pad < 0 )) && pad=0
      echo -e "${TN_C_D}│${TN_R}$l$(printf '%*s' $gap '')$r$(printf '%*s' $pad '')${TN_C_D}│${TN_R}"
   else
      if [[ -n "$num2" ]]; then
         tn_item "$num" "$label" "$st"
         tn_item "$num2" "$label2" "$st2"
         return 0
      fi
      lv=$(tn_vis "$l")
      pad=$(( TN_W - 2 - ${#lv} )); (( pad < 0 )) && pad=0
      echo -e "${TN_C_D}│${TN_R}$l$(printf '%*s' $pad '')${TN_C_D}│${TN_R}"
   fi
}

# ---- botões de atalho --------------------------------------
tn_shortcuts () { # "C:Checkuser" "B:BadVPN" ...
   local item k l out used inner
   tn_width
   out="${TN_C_D}│${TN_R} "
   used=0
   for item in "$@"; do
      k="${item%%:*}"; l="${item#*:}"
      out+="${TN_C_D}(${TN_R}${TN_C_Y}${k}${TN_R}${TN_C_D})${TN_R} ${TN_C_M}${l}${TN_R}  "
      used=$(( used + ${#k} + ${#l} + 7 ))
   done
   inner=$(( TN_W - 3 - used )); (( inner < 0 )) && inner=0
   echo -e "$out$(printf '%*s' $inner '')${TN_C_D}│${TN_R}"
}

# ---- mensagens padronizadas (estados) ----------------------
tn_ok ()   { local m="$1" w; w=$(( ${#m} - 3 )); (( w < 3 )) && w=3
   echo -e "${TN_C_D}┌─${TN_R} ${TN_C_G}✔${TN_R} ${TN_C_D}$(tn_rep $w)┐${TN_R}"
   echo -e "${TN_C_D}│${TN_R} ${TN_C_G}${m}${TN_R} ${TN_C_D}│${TN_R}"
   echo -e "${TN_C_D}└$(tn_rep $(( ${#m} + 1 )))┘${TN_R}"; }
tn_erro () { local m="$1" w=$(( ${#m} - 3 )); (( w < 3 )) && w=3
   echo -e "${TN_C_D}┌─${TN_R} ${TN_C_R}✖${TN_R} ${TN_C_D}$(tn_rep $w)┐${TN_R}"
   echo -e "${TN_C_D}│${TN_R} ${TN_C_R}${m}${TN_R} ${TN_C_D}│${TN_R}"
   echo -e "${TN_C_D}└$(tn_rep $(( ${#m} + 1 )))┘${TN_R}"; }
tn_info () { local m="$1" w=$(( ${#m} - 3 )); (( w < 3 )) && w=3
   echo -e "${TN_C_D}┌─${TN_R} ${TN_C_C}ℹ${TN_R} ${TN_C_D}$(tn_rep $w)┐${TN_R}"
   echo -e "${TN_C_D}│${TN_R} ${TN_C_M}${m}${TN_R} ${TN_C_D}│${TN_R}"
   echo -e "${TN_C_D}└$(tn_rep $(( ${#m} + 1 )))┘${TN_R}"; }

# ---- formulários -------------------------------------------
tn_field () { echo -e " ${TN_C_C}▸${TN_R} ${TN_C_N}$1${TN_R}"; }
tn_prompt () {
   echo -ne " ${TN_C_C}➤${TN_R} ${TN_C_N}INFORME UMA OPÇÃO${TN_R} ${TN_C_D}:${TN_R} "
}
