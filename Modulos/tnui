#!/bin/bash
# ============================================================
#  T N U I  —  Biblioteca visual TECH NET VPN
#  Identidade padrão do painel: quadros, cartões, chips e
#  mensagens consistentes, adaptando-se à largura do terminal
#  (celular, tablet ou computador). Ubuntu 20.04 / 24.04.
# ============================================================

TN_W=80

# ---- paleta da marca (ESC real via $'...' para medição correta)
TN_C_B=$'\033[38;5;39m'   # azul elétrico (marca)
TN_C_C=$'\033[38;5;44m'   # ciano (marca)
TN_C_G=$'\033[1;32m'      # verde  (sucesso)
TN_C_R=$'\033[1;31m'      # vermelho (erro)
TN_C_Y=$'\033[1;33m'      # amarelo (destaque)
TN_C_N=$'\033[1;37m'      # branco forte (títulos)
TN_C_M=$'\033[38;5;250m'  # cinza claro (textos)
TN_C_D=$'\033[38;5;240m'  # cinza escuro (bordas discretas)
TN_R=$'\033[0m'

# ---- utilidades internas -----------------------------------
tn_width () {
   local w
   w=$(tput cols 2>/dev/null)
   [[ -z "$w" || "$w" -lt 1 ]] && w=${COLUMNS:-80}
   [[ "$w" -lt 36 ]] && w=36
   TN_W=$w
}

# remove códigos ANSI para medir largura visível
tn_vis () { printf '%s' "$1" | sed 's/\x1b\[[0-9;]*m//g'; }

# traço repetido (UTF-8 seguro)
tn_rep () { printf '%*s' "$1" '' | sed 's/ /─/g'; }

tn_pad () { # $1=texto $2=largura visível $3=alinhamento l|r|c
   local vis l m r
   vis=$(tn_vis "$1"); l=$(( $2 - ${#vis} )); (( l < 0 )) && l=0
   if [[ "$3" == "r" ]]; then
      printf '%*s%s' "$l" "" "$1"
   elif [[ "$3" == "c" ]]; then
      m=$(( l / 2 )); r=$(( l - m ))
      printf '%*s%s%*s' "$m" "" "$1" "$r" ""
   else
      printf '%s%*s' "$1" "$l" ""
   fi
}

tn_cut () { # corta texto simples em N caracteres visíveis
   local v; v=$(tn_vis "$1"); if [[ ${#v} -le $2 ]]; then printf '%s' "$1"; else printf '%s' "${v:0:$2}"; fi
}

# ---- logo da marca -----------------------------------------
