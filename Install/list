
#!/bin/bash
#====================================================
# @TECHNETVPN — Instalador auxiliar v1.3
# Compatibilidade: lst lst1 lst2 key1
# Origem: projeto local, com GitHub como fallback.
#====================================================

set -o pipefail

SRC="${PANEL_SOURCE_DIR:-}"

if [[ -z "$SRC" && -f /etc/technetvpn/source_dir ]]; then
    SRC=$(cat /etc/technetvpn/source_dir 2>/dev/null)
fi

if [[ -z "$SRC" ]]; then
    SRC=$(cd "$(dirname "$(readlink -f "$0")")/.." 2>/dev/null && pwd)
fi

PANEL_REPO="${PANEL_REPO:-https://raw.githubusercontent.com/Luciliosantos/TECH-NET-VPN/main}"

mkdir -p /etc/technetvpn
touch /etc/technetvpn/install.log

# Argumentos originais: manter compatibilidade.
lst="${1:-}"
lst1="${2:-}"
lst2="${3:-}"
key1="${4:-}"
key2="crz"

# A variável key1 é mantida por compatibilidade com o instalador antigo.
# Ela não substitui nem interfere na licença TECH NET VPN.

log_inst() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> /etc/technetvpn/install.log
}

#====================================================
# DOWNLOAD SEGURO
#====================================================

fun_get() {
    local rel="$1"
    local dst="$2"
    local tmp=""
    local origem=""

    [[ -z "$rel" || -z "$dst" ]] && return 1

    mkdir -p "$(dirname "$dst")" 2>/dev/null || return 1

    tmp="${dst}.tmp.$$"
    rm -f "$tmp"

    # 1. Primeiro tenta copiar do projeto local.
    if [[ -n "$SRC" && -s "$SRC/$rel" ]]; then
        if cp -f "$SRC/$rel" "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
            origem="local"
        fi
    fi

    # 2. Se não encontrou localmente, tenta GitHub.
    if [[ -z "$origem" ]]; then
        if command -v curl >/dev/null 2>&1; then
            for tentativa in 1 2 3; do
                if curl -fLsS --connect-timeout 8 --max-time 45 \
                    "$PANEL_REPO/$rel" -o "$tmp" 2>/dev/null &&
                    [[ -s "$tmp" ]]; then
                    origem="github"
                    break
                fi
                rm -f "$tmp"
                sleep 1
            done
        fi

        if [[ -z "$origem" ]] && command -v wget >/dev/null 2>&1; then
            for tentativa in 1 2 3; do
                if wget -q -T 15 -t 1 -O "$tmp" \
                    "$PANEL_REPO/$rel" 2>/dev/null &&
                    [[ -s "$tmp" ]]; then
                    origem="github"
                    break
                fi
                rm -f "$tmp"
                sleep 1
            done
        fi
    fi

    if [[ -z "$origem" ]]; then
        rm -f "$tmp"
        log_inst "ERRO: arquivo não encontrado: $rel"
        return 1
    fi

    # Scripts não são instalados se estiverem com sintaxe inválida.
    case "$rel" in
        *.sh)
            if ! bash -n "$tmp" >/dev/null 2>&1; then
                rm -f "$tmp"
                log_inst "ERRO: sintaxe inválida: $rel"
                return 1
            fi
            ;;
    esac

    if ! mv -f "$tmp" "$dst"; then
        rm -f "$tmp"
        log_inst "ERRO: não foi possível instalar: $rel"
        return 1
    fi

    log_inst "OK: $rel instalado por $origem"
    return 0
}

#====================================================
# IP DA VPS
#====================================================

IP=""
IP2=""

if command -v wget >/dev/null 2>&1; then
    IP=$(wget -q -T 5 -t 1 -O- https://ipv4.icanhazip.com 2>/dev/null)
    IP2=$(wget -q -T 5 -t 1 -O- http://whatismyip.akamai.com/ 2>/dev/null)
fi

if [[ -n "$IP" && -n "$IP2" && "$IP" != "$IP2" ]]; then
    ipdovps="$IP2"
else
    ipdovps="${IP:-$(hostname -I 2>/dev/null | awk '{print $1}')}"
fi

echo "$ipdovps" > /etc/IP

#====================================================
# FUSO HORÁRIO
#====================================================

echo "America/Sao_Paulo" > /etc/timezone
ln -fs /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime >/dev/null 2>&1
dpkg-reconfigure --frontend noninteractive tzdata >/dev/null 2>&1

# Mantém o comportamento original quando lst1 está vazio.
if [[ -z "$lst1" ]]; then
    rm -f "${lst:-}" 2>/dev/null
    exit 0
fi

#====================================================
# DIRETÓRIOS
#====================================================

mkdir -p \
    /etc/SSHPlus/v2ray \
    /etc/SSHPlus/senha \
    /etc/SSHPlus/userteste \
    /etc/SSHPlus/.tmp \
    /etc/SSHPlus/inst \
    /etc/bot/info-users \
    /etc/bot/arquivos \
    /etc/bot/revenda \
    /etc/bot/suspensos \
    /etc/rec \
    /usr/lib \
    "$lst2"

touch /etc/SSHPlus/Exp
touch /etc/bot/lista_ativos
touch /etc/bot/lista_suspensos

# Registra a origem do projeto para futuras execuções.
if [[ -n "$SRC" && -d "$SRC" ]]; then
    echo "$SRC" > /etc/technetvpn/source_dir
fi

#====================================================
# ARQUIVOS DE INSTALAÇÃO
#====================================================

for _a in cert key stunnel EasyRSA-3.0.1.tgz squid3 sshd_config; do
    fun_get "Install/$_a" "/etc/SSHPlus/inst/$_a" || true
done

fun_get "Sistema/botssh" "/etc/SSHPlus/inst/botssh" || true

#====================================================
# IDENTIFICAÇÃO TECH NET VPN
#====================================================

echo 'by: @TECHNETVPN' > /usr/lib/sshplus
cp -f /usr/lib/sshplus "$lst2/licence" 2>/dev/null
cp -f /usr/lib/sshplus /etc/SSHPlus/.tmp/crazy 2>/dev/null

#====================================================
# APACHE E SSH
#====================================================

if command -v netstat >/dev/null 2>&1; then
    if netstat -nplt 2>/dev/null | grep -w apache2 | grep -q ':80'; then
        if [[ -f /etc/apache2/ports.conf ]]; then
            sed -i 's/Listen 80/Listen 81/g' /etc/apache2/ports.conf
            service apache2 restart >/dev/null 2>&1 || true
        fi
    fi
fi

if [[ -f /etc/ssh/sshd_config ]]; then
    if grep -q '^#Port 22' /etc/ssh/sshd_config; then
        sed -i 's/^#Port 22/Port 22/' /etc/ssh/sshd_config
    fi

    sed -i '/^PasswordAuthentication[[:space:]]/d' /etc/ssh/sshd_config
    echo "PasswordAuthentication yes" >> /etc/ssh/sshd_config
    service ssh restart >/dev/null 2>&1 || true
fi

#====================================================
# MÓDULOS DO PAINEL
#====================================================

_dir1="/bin"
_dir2="/etc/SSHPlus"

mkdir -p "$_dir1" "$_dir2"

# Lista original de módulos preservada.
_mdls=(
"addhost" "ajuda" "alterarlimite" "alterarsenha" "tcptweaker.sh"
"checkers" "utili" "multi" "apache2menu" "check" "chuser"
"limit" "rps_cpu" "attscript" "badpro" "badpro1" "badvpn2"
"badvpn3" "banner" "bashtop" "ddos" "blocksite" "blockt"
"blockuser" "bot" "botssh" "conexao" "criarteste"
"criarusuario" "delhost" "delscript" "detalhes" "droplimiter"
"expcleaner" "fr" "infousers" "inst-botteste" "initcheck"
"instsqd" "limiter" "menu" "menub" "tnui" "mudardata"
"mtuning" "multi" "open.py" "otimizar" "painelv2ray"
"proxy.py" "reiniciarservicos" "reiniciarsistema" "remover"
"senharoot" "ShellBot.sh" "speedtest" "sshmonitor"
"swapmemory" "trafegototal" "trojan-go" "uexpired"
"userbackup" "verifatt" "verifbot" "v2raymanager"
"webmin.sh" "websocket.sh" "wsproxy.py" "pkill.sh"
)

for _arq in "${_mdls[@]}"; do
    # Só substitui o arquivo antigo depois de obter uma cópia válida.
    if fun_get "Modulos/$_arq" "$_dir1/$_arq"; then
        chmod +x "$_dir1/$_arq" 2>/dev/null || true
    fi
done

#====================================================
# ARQUIVOS AUXILIARES
#====================================================

for _mv in cabecalho bot open.py proxy.py wsproxy.py; do
    if [[ -f "$_dir1/$_mv" ]]; then
        mv -f "$_dir1/$_mv" "$_dir2/$_mv"
    fi
done

#====================================================
# HOSTS
#====================================================

_arq_host="/etc/hosts"

_host=(
"d1n212ccp6ldpw.cloudfront.net"
"dns.whatsapp.net"
"portalrecarga.vivo.com.br"
"navegue.vivo.com.br"
"www.whatsapp.net"
)

for host in "${_host[@]}"; do
    if ! grep -qw "$host" "$_arq_host" 2>/dev/null; then
        sed -i "1i\\127.0.0.1 $host" "$_arq_host"
    fi
done

#====================================================
# AUTOSTART
#====================================================

if [[ ! -f /etc/autostart ]]; then
    cat > /etc/autostart <<'EOF'
#!/bin/bash
clear
#INICIO AUTOMATICO
EOF
fi

chmod +x /etc/autostart

# Não encerra sessões screen de outros serviços.
# Preserva o conteúdo existente do autostart.

#====================================================
# CRONTAB
#====================================================

# Preserva tarefas de outros programas e substitui somente
# as quatro tarefas pertencentes ao painel.
_tmpcron=$(mktemp)

crontab -l 2>/dev/null | grep -vE \
'^[[:space:]]*(@daily[[:space:]]+/bin/verifatt|@reboot[[:space:]]+/etc/autostart|\*[[:space:]]+\*[[:space:]]+\*[[:space:]]+\*[[:space:]]+\*[[:space:]]+/etc/autostart|0[[:space:]]+\*/6[[:space:]]+\*[[:space:]]+\*[[:space:]]+/bin/uexpired)([[:space:]]|$)' \
> "$_tmpcron"

{
    cat "$_tmpcron"
    echo "@daily /bin/verifatt"
    echo "@reboot /etc/autostart"
    echo "* * * * * /etc/autostart"
    echo "0 */6 * * * /bin/uexpired"
} | crontab -

rm -f "$_tmpcron"

#====================================================
# VERSÃO
#====================================================

_vlv=""

if [[ -n "$SRC" && -f "$SRC/Modulos/versao" ]]; then
    _vlv=$(sed -n '1p' "$SRC/Modulos/versao" 2>/dev/null | tr -d '\r\n')
fi

if [[ -z "$_vlv" ]] && command -v wget >/dev/null 2>&1; then
    _vlv=$(wget -q -T 5 -t 1 -O- "$PANEL_REPO/Modulos/versao" 2>/dev/null | tr -d '\r\n')
fi

[[ -z "$_vlv" ]] && _vlv="121"

echo "$_vlv" > /bin/versao
cp -f /bin/versao /home/sshplus 2>/dev/null

#====================================================
# JQ — RESPEITA A ARQUITETURA
#====================================================

case "$(uname -m)" in
    x86_64|amd64)
        if [[ ! -x "$(command -v jq 2>/dev/null)" ]]; then
            if fun_get "Install/jq-linux64" "$HOME/jq-linux64"; then
                chmod +x "$HOME/jq-linux64"
                mkdir -p /usr/local/bin
                mv -f "$HOME/jq-linux64" /usr/local/bin/jq
            fi
        fi
        ;;
    *)
        if ! command -v jq >/dev/null 2>&1; then
            apt-get update -qq >/dev/null 2>&1 || true
            apt-get install -y jq >/dev/null 2>&1 || true
        fi
        ;;
esac

#====================================================
# SERVIÇOS
#====================================================

service cron restart >/dev/null 2>&1 || true
service ssh restart >/dev/null 2>&1 || true

if [[ -d /var/www/html/openvpn ]]; then
    service apache2 restart >/dev/null 2>&1 || true
fi

#====================================================
# WEBSOCKET E PROXY
#====================================================

cd /etc/SSHPlus || exit 1

if fun_get "Modulos/WebSocket" WebSocket; then
    chmod 777 WebSocket
fi

if fun_get "Modulos/proxydt" proxydt; then
    chmod 777 proxydt
fi

cd "$HOME" || true

#====================================================
# ONLINE APP E BADVPN
#====================================================

fun_get "Install/onlineapp" "$_dir1/onlineapp" &&
    chmod +x "$_dir1/onlineapp"

case "$(uname -m)" in
    x86_64|amd64)
        fun_get "Install/badvpn-udpgw" "$_dir1/badvpn-udpgw" &&
            chmod +x "$_dir1/badvpn-udpgw"
        ;;
esac

#====================================================
# CHUSER / USERSCHECK / CHECKUSER
#====================================================

fun_get "Install/chuser" "$_dir1/chuser" &&
    chmod +x "$_dir1/chuser"

fun_get "Install/userscheck" "$_dir1/userscheck" &&
    chmod +x "$_dir1/userscheck"

mkdir -p /usr/lib/checkuser

fun_get "Install/checkuser.py" "/usr/lib/checkuser/checkuser.py" &&
    chmod +x /usr/lib/checkuser/checkuser.py

#====================================================
# FINALIZAÇÃO
#====================================================

# Remove somente a cópia temporária do instalador auxiliar.
if [[ -n "$lst" && "$lst" != "/" ]]; then
    rm -f "$lst" 2>/dev/null
fi

log_inst "Instalação auxiliar finalizada."
exit 0
