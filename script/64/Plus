        cat /var/lib/dbus/machine-id | tr -d '[:space:]'

        return

    fi

    hostname
}


# ==========================================================
# VALIDAR LICENÇA NO BOT LICENÇAS
# ==========================================================

validar_licenca() {

    echo ""
    echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\033[1;33m🔐 LICENÇA DO PAINEL VPN\033[0m"
    echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""

    read -p "Digite sua licença: " LICENCA

    LICENCA=$(echo "$LICENCA" | tr -d '[:space:]' | tr '[:lower:]' '[:upper:]')

    if [[ -z "$LICENCA" ]]; then

        echo ""
        echo -e "\033[1;31m❌ Licença não informada.\033[0m"

        sleep 3

        rm -f "$HOME/Plus"

        exit 1

    fi


    VPS_ID=$(obter_vps_id)


    if [[ -z "$VPS_ID" ]]; then

        echo ""
        echo -e "\033[1;31m❌ Não foi possível identificar este VPS.\033[0m"

        sleep 3

        rm -f "$HOME/Plus"

        exit 1

    fi


    echo ""
    echo -e "\033[1;36m🔎 Validando licença...\033[0m"
    echo ""


    RESPOSTA=$(curl -sS \
        --connect-timeout 10 \
        --max-time 20 \
        -X POST \
        -H "Content-Type: application/json" \
        -d "{\"codigo\":\"$LICENCA\",\"vps_id\":\"$VPS_ID\",\"produto\":\"$PRODUTO_LICENCA\"}" \
        "$LICENCA_API" 2>/dev/null)


    if [[ -z "$RESPOSTA" ]]; then

        echo ""
        echo -e "\033[1;31m❌ Não foi possível conectar ao servidor de licenças ($LICENCA_API).\033[0m"
        echo ""
        # MODO LIVRE: pula a licenca sem simular validacao (usado em
        # reinstalacao/teste quando o servidor de licenca esta offline).
        if [[ -f /etc/technetvpn/licenca.conf ]] && grep -qi '^LICENCA_MODO *= *livre' /etc/technetvpn/licenca.conf; then
            echo -e "\033[1;33mMODO LIVRE configurado: instalando SEM validação de licença.\033[0m"
            mkdir -p /etc/technetvpn
            echo "LIVRE-MODO-$(date '+%Y-%m-%d')" > /etc/technetvpn/licenca
            return 0
        fi
        echo -e "\033[1;33mO painel NÃO valida a licença sem esse servidor.\033[0m"
        echo ""
        echo -e "\033[1;37m[\033[1;31mR\033[1;37m]\033[1;33m Tentar novamente"
        echo -e "\033[1;37m[\033[1;31mC\033[1;37m]\033[1;33m Continuar a instalação SEM licença (registrado como não validada)"
        echo -e "\033[1;37m[\033[1;31mX\033[1;37m]\033[1;33m Abortar instalação"
        echo ""
        read -p "O que deseja fazer? [R/C/X]: " -e -i R opcl
        case "$(echo "$opcl" | tr '[:lower:]' '[:upper:]')" in
            C)
                echo ""
                echo -e "\033[1;33m⚠ INSTALAÇÃO SEM LICENÇA VALIDADA (servidor offline).\033[0m"
                mkdir -p /etc/technetvpn
                echo "NAO-VALIDADA-SERVIDOR-OFFLINE-$(date '+%Y-%m-%d')" > /etc/technetvpn/licenca
                return 0
                ;;
            X)
                rm -f "$HOME/Plus"
                exit 1
                ;;
            *)
                validar_licenca
                return $?
                ;;
        esac

    fi


    VALIDADA=""

    echo "$RESPOSTA" | grep -Eiq \
        '"valida"[[:space:]]*:[[:space:]]*true|"valid"[[:space:]]*:[[:space:]]*true|"ok"[[:space:]]*:[[:space:]]*true' \
        && VALIDADA="SIM"


    if [[ "$VALIDADA" != "SIM" ]]; then

        MENSAGEM=$(echo "$RESPOSTA" | sed -n 's/.*"mensagem"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

        [[ -z "$MENSAGEM" ]] && \
            MENSAGEM=$(echo "$RESPOSTA" | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

        [[ -z "$MENSAGEM" ]] && \
            MENSAGEM="Licença inválida, vencida ou não autorizada para este VPS."


        echo ""
        echo -e "\033[1;31m❌ LICENÇA NÃO AUTORIZADA!\033[0m"
        echo ""
        echo -e "\033[1;33m$MENSAGEM\033[0m"
        echo ""

        sleep 5

        rm -f "$HOME/Plus"

        exit 1

    fi


    echo ""
    echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\033[1;32m✅ LICENÇA VALIDADA COM SUCESSO!\033[0m"
    echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""

    sleep 2


    mkdir -p /etc/technetvpn

    echo "$LICENCA" > /etc/technetvpn/licenca

    chmod 600 /etc/technetvpn/licenca

    echo "$VPS_ID" > /etc/technetvpn/vps_id

    chmod 600 /etc/technetvpn/vps_id

}


