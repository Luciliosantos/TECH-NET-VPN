#!/bin/bash
#====================================================
# TECH NET VPN — INSTALADOR ARM64
# Menu de acesso DEV / CLIENTE
# Compatível com Install/list e projeto GitHub.
# Mantém o argumento legado key por compatibilidade.
#====================================================

clear 2>/dev/null || true

export DEBIAN_FRONTEND=noninteractive

RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;36m'
NC='\033[0m'

#====================================================
# ROOT
#====================================================

if [[ "$(id -u)" != "0" ]]; then
    echo -e "${RED}Erro: execute este instalador como root.${NC}"
    exit 1
fi

cd "$HOME" || exit 1

#====================================================
# DEPENDÊNCIAS INICIAIS
#====================================================

apt-get update -qq >/dev/null 2>&1 || true
apt-get install -y curl wget git figlet lolcat boxes >/dev/null 2>&1 || true

#====================================================
# VARIÁVEIS ORIGINAIS
#====================================================

_lnk=$(echo 'z1:y#x.5s0ul&p4hs$s.0a72d*n-e!v89e032:3r' | sed -e 's/[^a-z.]//ig' | rev)
_Ink=$(echo '/3×u3#s87r/l32o4×c1a×l1/83×l24×i0b×' | sed -e 's/[^a-z/]//ig')
_1nk=$(echo '/3×u3#s×87r/83×l2×4×i0b×' | sed -e 's/[^a-z/]//ig')

key="${key:-}"

mkdir -p "$_Ink" "$_1nk" /etc/technetvpn

PANEL_REPO="${PANEL_REPO:-https://raw.githubusercontent.com/Luciliosantos/TECH-NET-VPN/main}"

#====================================================
# LOCALIZAÇÃO DO PROJETO
#====================================================

SRC="${PANEL_SOURCE_DIR:-}"

if [[ -z "$SRC" && -f /etc/technetvpn/source_dir ]]; then
    SRC=$(cat /etc/technetvpn/source_dir 2>/dev/null)
fi

if [[ -z "$SRC" ]]; then
    SRC=$(cd "$(dirname "$(readlink -f "$0")")/../.." 2>/dev/null && pwd)
fi

#====================================================
# DOWNLOAD SEGURO
#====================================================

fun_src() {
    local rel="$1"
    local dst="$2"
    local tmp=""
    local ok=""

    [[ -z "$rel" || -z "$dst" ]] && return 1

    mkdir -p "$(dirname "$dst")" 2>/dev/null || return 1

    tmp="${dst}.tmp.$$"
    rm -f "$tmp"

    # Primeiro tenta o projeto já extraído na VPS.
    if [[ -n "$SRC" && -s "$SRC/$rel" ]]; then
        if cp -f "$SRC/$rel" "$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
            ok="local"
        fi
    fi

    # GitHub como alternativa.
    if [[ -z "$ok" ]] && command -v curl >/dev/null 2>&1; then
        for tentativa in 1 2 3; do
            if curl -fLsS --connect-timeout 8 --max-time 45 \
                "$PANEL_REPO/$rel" -o "$tmp" 2>/dev/null &&
                [[ -s "$tmp" ]]; then
                ok="github"
                break
            fi
            rm -f "$tmp"
            sleep 1
        done
    fi

    if [[ -z "$ok" ]] && command -v wget >/dev/null 2>&1; then
        for tentativa in 1 2 3; do
            if wget -q -T 15 -t 1 -O "$tmp" \
                "$PANEL_REPO/$rel" 2>/dev/null &&
                [[ -s "$tmp" ]]; then
                ok="github"
                break
            fi
            rm -f "$tmp"
            sleep 1
        done
    fi

    if [[ -z "$ok" ]]; then
        rm -f "$tmp"
        echo "Falha ao obter $rel" >> /etc/technetvpn/install.log
        return 1
    fi

    case "$rel" in
        *.sh)
            if ! bash -n "$tmp" >/dev/null 2>&1; then
                rm -f "$tmp"
                echo "Sintaxe inválida: $rel" >> /etc/technetvpn/install.log
                return 1
            fi
            ;;
    esac

    if ! mv -f "$tmp" "$dst"; then
        rm -f "$tmp"
        return 1
    fi

    echo "OK: $rel ($ok)" >> /etc/technetvpn/install.log
    return 0
}

#====================================================
# BARRA DE PROGRESSO
#====================================================

fun_bar() {
    local func="$1"

    (
        "$func"
        echo $? > "$HOME/.technetvpn_install_status"
    ) >/dev/null 2>&1 &

    local pid=$!

    tput civis 2>/dev/null || true
    echo -ne "\033[1;31m❪\033[1;33mAGUARDE \033[1;37m> \033[1;32m|"

    while kill -0 "$pid" 2>/dev/null; do
        echo -ne "\033[1;32m█"
        sleep 0.3
    done

    wait "$pid"
    local result=$?

    echo -e "\033[1;33m]\033[1;37m - \033[1;32mOK!\033[0m"
    tput cnorm 2>/dev/null || true

    return "$result"
}

#====================================================
# LICENÇA DE CLIENTE
#====================================================

LICENCA_API="http://191.252.218.217:8787/api/licenca/validar"
PRODUTO_LICENCA="PAINELVPN"

obter_vps_id() {
    VPS_ID=""

    if [[ -s /etc/machine-id ]]; then
        VPS_ID="$(tr -d '[:space:]' < /etc/machine-id)"
    fi

    if [[ -z "$VPS_ID" && -s /var/lib/dbus/machine-id ]]; then
        VPS_ID="$(tr -d '[:space:]' < /var/lib/dbus/machine-id)"
    fi

    [[ -n "$VPS_ID" ]] || VPS_ID="$(hostname)"
    [[ -n "$VPS_ID" ]]
}

validar_licenca() {
    echo ""
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${YELLOW}       LICENÇA TECH NET VPN${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

    read -r -p "Digite sua licença: " LICENCA
    LICENCA="$(echo "$LICENCA" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')"

    if [[ -z "$LICENCA" ]]; then
        echo -e "${RED}Licença não informada.${NC}"
        return 1
    fi

    obter_vps_id || return 1

    echo -e "${BLUE}Validando licença...${NC}"

    RESPOSTA="$(curl -fsS --connect-timeout 10 --max-time 20 \
        -H "Content-Type: application/json" \
        -X POST \
        -d "{\"codigo\":\"$LICENCA\",\"vps_id\":\"$VPS_ID\",\"produto\":\"$PRODUTO_LICENCA\"}" \
        "$LICENCA_API" 2>/dev/null)" || RESPOSTA=""

    if [[ -z "$RESPOSTA" ]]; then
        echo -e "${RED}Não foi possível conectar ao servidor de licenças.${NC}"

        if [[ -f /etc/technetvpn/licenca.conf ]] &&
           grep -qi '^LICENCA_MODO *= *livre' /etc/technetvpn/licenca.conf; then
            echo "LIVRE-MODO-$(date '+%Y-%m-%d')" > /etc/technetvpn/licenca
            return 0
        fi

        echo "[R] Tentar novamente"
        echo "[C] Continuar sem licença validada"
        echo "[X] Abortar"

        read -r -p "Opção [R/C/X]: " opcl

        case "$(echo "$opcl" | tr '[:lower:]' '[:upper:]')" in
            C)
                echo "NAO-VALIDADA-SERVIDOR-OFFLINE-$(date '+%Y-%m-%d')" > /etc/technetvpn/licenca
                return 0
                ;;
            X)
                return 1
                ;;
            *)
                validar_licenca
                return $?
                ;;
        esac
    fi

    if echo "$RESPOSTA" | grep -Eiq \
        '"(valida|valid|ok)"[[:space:]]*:[[:space:]]*true|"status"[[:space:]]*:[[:space:]]*"(valid|valida|ativa|ativo|approved|aprovado)"'; then

        printf '%s\n' "$LICENCA" > /etc/technetvpn/licenca
        printf '%s\n' "$VPS_ID" > /etc/technetvpn/vps_id

        chmod 600 /etc/technetvpn/licenca /etc/technetvpn/vps_id

        echo -e "${GREEN}Licença validada com sucesso!${NC}"
        sleep 2
        return 0
    fi

    MENSAGEM="$(echo "$RESPOSTA" | sed -n 's/.*"mensagem"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"

    [[ -n "$MENSAGEM" ]] ||
        MENSAGEM="$(echo "$RESPOSTA" | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')"

    echo -e "${RED}Licença não autorizada: ${MENSAGEM:-licença inválida ou vencida}.${NC}"
    return 1
}

#====================================================
# ESCOLHA DO TIPO DE ACESSO
#====================================================

escolher_tipo_acesso() {
    local opcao=""

    echo ""
    echo -e "${BLUE}========================================${NC}"
    echo -e "${YELLOW}          TECH NET VPN${NC}"
    echo -e "${BLUE}========================================${NC}"
    echo ""
    echo "  1 - ACESSO DEV"
    echo "  2 - ACESSO CLIENTE"
    echo ""
    read -r -p "Escolha uma opção [2]: " opcao
    opcao="${opcao:-2}"

    case "$opcao" in
        1)
            echo ""
            echo -e "${YELLOW}ACESSO DE DESENVOLVEDOR${NC}"

            if ! fun_src "Install/licenca_master.sh" "$_Ink/licenca_master.sh"; then
                echo -e "${RED}Não foi possível obter o verificador MASTER.${NC}"
                return 1
            fi

            chmod 700 "$_Ink/licenca_master.sh"

            if ! bash "$_Ink/licenca_master.sh"; then
                echo -e "${RED}Acesso DEV não autorizado.${NC}"
                return 1
            fi

            echo "DEV" > /etc/technetvpn/tipo_acesso
            chmod 600 /etc/technetvpn/tipo_acesso
            return 0
            ;;
        2)
            if ! validar_licenca; then
                echo -e "${RED}Licença de cliente não validada.${NC}"
                return 1
            fi

            echo "CLIENTE" > /etc/technetvpn/tipo_acesso
            chmod 600 /etc/technetvpn/tipo_acesso
            return 0
            ;;
        *)
            echo -e "${RED}Opção inválida. Instalação cancelada.${NC}"
            return 1
            ;;
    esac
}

#====================================================
# INSTALADOR AUXILIAR
#====================================================

clear
figlet "TECH NET VPN" 2>/dev/null | lolcat 2>/dev/null || echo "TECH NET VPN"

echo -e "${BLUE}VERIFICANDO ARQUIVOS DE INSTALAÇÃO...${NC}"

if ! fun_src "Install/list" "$_Ink/list"; then
    echo -e "${RED}ERRO: não foi possível obter Install/list.${NC}"
    echo "Verifique a conexão e o repositório."
    exit 1
fi

chmod +x "$_Ink/list"

if ! bash -n "$_Ink/list"; then
    echo -e "${RED}ERRO: Install/list está com sintaxe inválida.${NC}"
    exit 1
fi

#====================================================
# MENU DE ACESSO
#====================================================

if ! escolher_tipo_acesso; then
    echo -e "${RED}Instalação interrompida na validação de acesso.${NC}"
    exit 1
fi

#====================================================
# ARQUIVOS AUXILIARES
#====================================================

fun_src "Install/versao" "$HOME/versao" || true
fun_src "Modulos/v2raymanager" "$HOME/v2raymanager" || true
fun_src "Modulos/botteste.sh" "$HOME/botteste.sh" || true

chmod +x "$HOME/v2raymanager" "$HOME/botteste.sh" 2>/dev/null || true

mkdir -p "$HOME/BOT"

fun_src "Modulos/ShellBot.sh" "$HOME/BOT/ShellBot.sh" || true
chmod +x "$HOME/BOT/ShellBot.sh" 2>/dev/null || true

mkdir -p /etc/rec

# Não sobrescreve arquivos de licença existentes.
if [[ ! -s /etc/rec/licence ]]; then
    echo "TECH NET VPN" > /etc/rec/licence
fi

if [[ ! -s /usr/lib/licence ]]; then
    echo "TECH NET VPN" > /usr/lib/licence
fi

#====================================================
# BANCO DE USUÁRIOS
#====================================================

optiondb="1"

if [[ -f "$HOME/usuarios.db" ]]; then
    clear
    figlet "TECH NET VPN" 2>/dev/null | lolcat 2>/dev/null

    echo "DADOS DE USUÁRIOS ENCONTRADOS!"
    echo
    echo "[1] MANTER DADOS ATUAIS"
    echo "[2] CRIAR NOVA BASE DE DADOS"
    echo

    read -r -p "Opção [1]: " optiondb
    optiondb="${optiondb:-1}"
else
    awk -F: '$3 >= 500 { print $1 " 1" }' /etc/passwd |
        grep -v '^nobody' > "$HOME/usuarios.db"
fi

if [[ "$optiondb" == "2" ]]; then
    cp -f "$HOME/usuarios.db" \
        "$HOME/usuarios.db.bak.$(date +%Y%m%d%H%M%S)" 2>/dev/null || true

    awk -F: '$3 >= 500 { print $1 " 1" }' /etc/passwd |
        grep -v '^nobody' > "$HOME/usuarios.db"
fi

#====================================================
# ATUALIZAÇÃO DO SISTEMA
#====================================================

clear
echo -e "${GREEN}ATUALIZANDO SISTEMA...${NC}"

fun_attlist() {
    apt-get update -y || return 1

    mkdir -p /usr/share/.plus
    echo "crz: $(date)" > /usr/share/.plus/.plus
}

fun_bar fun_attlist || {
    echo -e "${YELLOW}AVISO: atualização do sistema apresentou falha.${NC}"
}

#====================================================
# PACOTES
#====================================================

clear
echo -e "${GREEN}INSTALANDO PACOTES...${NC}"

inst_pct() {
    local pacotes=(
        bc screen nano unzip lsof net-tools dos2unix
        nload jq curl figlet python3 python3-pip at
        socat cron wget git
    )

    apt-get install -y "${pacotes[@]}" || return 1

    if command -v pip3 >/dev/null 2>&1; then
        pip3 install speedtest-cli >/dev/null 2>&1 || true
    fi
}

fun_bar inst_pct || {
    echo -e "${YELLOW}AVISO: alguns pacotes podem não ter sido instalados.${NC}"
}

#====================================================
# FIREWALL
#====================================================

if command -v ufw >/dev/null 2>&1; then
    ufw allow 443/tcp >/dev/null 2>&1 || true
    ufw allow 80/tcp >/dev/null 2>&1 || true
    ufw allow 3128/tcp >/dev/null 2>&1 || true
    ufw allow 8799/tcp >/dev/null 2>&1 || true
    ufw allow 8080/tcp >/dev/null 2>&1 || true
fi

#====================================================
# PYTHON
#====================================================

otimize_python() {
    apt-get install -y python3 python3-pip python-is-python3 >/dev/null 2>&1 || true

    if ! command -v python3 >/dev/null 2>&1; then
        return 1
    fi

    python3 -m pip install --upgrade pip >/dev/null 2>&1 || true
}

clear
echo -e "${GREEN}CONFIGURANDO PYTHON...${NC}"

fun_bar otimize_python || {
    echo -e "${YELLOW}AVISO: não foi possível concluir a configuração do Python.${NC}"
}

#====================================================
# INSTALAÇÃO FINAL DO PAINEL
#====================================================

clear
echo -e "${GREEN}INSTALANDO FUNÇÕES E DEFINIÇÕES...${NC}"

if ! bash "$_Ink/list" "$_lnk" "$_Ink" "$_1nk" "$key"; then
    echo -e "${RED}ERRO: falha durante a instalação auxiliar.${NC}"
    exit 1
fi

#====================================================
# FINALIZAÇÃO
#====================================================

clear
cd "$HOME" || exit 1

if ! grep -q 'TECH NET VPN' /root/.bashrc 2>/dev/null; then
    cat >> /root/.bashrc <<'EOF'

clear
DATE=$(date +"%d-%m-%y")
TIME=$(date +"%T")
figlet -k TECH NET VPN | lolcat
echo " NOME DO SERVIDOR : $HOSTNAME"
echo " SERVIDOR LIGADO À : $(uptime -p)"
echo " DATA : $DATE"
echo " HORA : $TIME"
echo "@TECHNETVPN"
echo -e "\033[1;31m DIGITE ( menu ) PARA ENTRAR\033[0m"
echo
EOF
fi

echo
echo -e "${GREEN}INSTALAÇÃO CONCLUÍDA!${NC}"
echo
echo -e "${YELLOW}Para iniciar, digite: ${GREEN}menu${NC}"
echo -e "${YELLOW}Suporte: @TECHNETVPN${NC}"
echo

rm -f "$HOME/Plus"
history -c 2>/dev/null || true

exit 0