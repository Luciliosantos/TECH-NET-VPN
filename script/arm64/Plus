otimize_python() {

    echo ""
    echo -e "\033[1;36mVerificando Python do sistema...\033[0m"

    # Não altera o Python padrão da VPS.
    # A versão usada será a fornecida pelo próprio sistema.

    if command -v python3 >/dev/null 2>&1; then

        PYTHON3_BIN="$(command -v python3)"
        PYTHON3_VERSION="$(python3 --version 2>&1)"

        echo -e "\033[1;32mPython detectado: $PYTHON3_VERSION\033[0m"
        echo -e "\033[1;37mExecutável: $PYTHON3_BIN\033[0m"

    else

        echo -e "\033[1;33mPython3 não encontrado.\033[0m"
        echo -e "\033[1;33mInstalando o Python3 fornecido pelo sistema...\033[0m"

        apt-get install python3 -y >/dev/null 2>&1

        if ! command -v python3 >/dev/null 2>&1; then

            echo ""
            echo -e "\033[1;31m❌ Não foi possível instalar o Python3.\033[0m"
            echo ""

            exit 1
        fi

        PYTHON3_BIN="$(command -v python3)"
        PYTHON3_VERSION="$(python3 --version 2>&1)"

        echo -e "\033[1;32mPython instalado: $PYTHON3_VERSION\033[0m"

    fi


    # Python2 somente se estiver disponível no repositório.
    apt-get install python -y >/dev/null 2>&1 || true
    apt-get install python2 -y >/dev/null 2>&1 || true


    # Pip correspondente ao Python3 do sistema.
    if ! command -v pip3 >/dev/null 2>&1; then
        apt-get install python3-pip -y >/dev/null 2>&1
    fi


    # Socat.
    apt-get install socat -y >/dev/null 2>&1


    echo -e "\033[1;32m✓ Python do sistema preservado.\033[0m"
    echo -e "\033[1;32m✓ Nenhum update-alternatives foi alterado.\033[0m"
    echo -e "\033[1;32m✓ Python3 continuará sendo o padrão da VPS.\033[0m"
}


