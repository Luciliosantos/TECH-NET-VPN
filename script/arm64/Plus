obter_vps_id() {

    VPS_ID=""

    if [[ -s /etc/machine-id ]]; then
        VPS_ID=$(cat /etc/machine-id | tr -d '[:space:]')
    fi

    if [[ -z "$VPS_ID" && -s /var/lib/dbus/machine-id ]]; then
        VPS_ID=$(cat /var/lib/dbus/machine-id | tr -d '[:space:]')
    fi

    if [[ -z "$VPS_ID" ]]; then
        VPS_ID=$(hostname | tr -d '[:space:]')
    fi

    if [[ -z "$VPS_ID" ]]; then
        echo -e "\033[1;31mNão foi possível identificar esta VPS.\033[0m"
        rm -rf $HOME/Plus >/dev/null 2>&1
        exit 1
    fi
}


validar_licenca() {

    clear

    echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo -e "\033[1;33m              TECH NET VPN\033[0m"
    echo -e "\033[1;36m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
    echo ""
    echo -e "\033[1;33m🔐 LICENÇA DO PAINEL VPN\033[0m"
    echo ""
    echo -ne "\033[1;37mDigite sua licença: \033[1;32m"

    read LICENCA

    LICENCA=$(echo "$LICENCA" | tr '[:lower:]' '[:upper:]' | tr -d '[:space:]')

    if [[ -z "$LICENCA" ]]; then
        echo ""
        echo -e "\033[1;31m❌ Nenhuma licença foi informada.\033[0m"
        sleep 3
        rm -rf $HOME/Plus >/dev/null 2>&1
        exit 1
    fi

    obter_vps_id

    echo ""
    echo -e "\033[1;33m🔄 Validando licença...\033[0m"
    echo ""

    RESPOSTA=$(curl -sS \
        --connect-timeout 10 \
        --max-time 20 \
        -H "Content-Type: application/json" \
        -X POST \
        -d "{\"codigo\":\"$LICENCA\",\"vps_id\":\"$VPS_ID\",\"produto\":\"$PRODUTO_LICENCA\"}" \
        "$LICENCA_API" 2>/dev/null)

    if [[ -z "$RESPOSTA" ]]; then
        echo -e "\033[1;31m❌ Não foi possível conectar ao servidor de licenças ($LICENCA_API).\033[0m"
        echo ""
        if [[ -f /etc/technetvpn/licenca.conf ]] && grep -qi '^LICENCA_MODO *= *livre' /etc/technetvpn/licenca.conf; then
            echo -e "\033[1;33mMODO LIVRE configurado: instalando SEM validação de licença.\033[0m"
            mkdir -p /etc/technetvpn
            echo "LIVRE-MODO-$(date '+%Y-%m-%d')" > /etc/technetvpn/licenca
            return 0
        fi
        echo -e "\033[1;33mO painel NÃO valida a licença sem esse servidor.\033[0m"
        echo ""
        echo -e "[R] Tentar novamente   [C] Continuar SEM licença (registrado)   [X] Abortar"
        read -p "O que deseja fazer? [R/C/X]: " -e -i R opcl
        case "$(echo "$opcl" | tr '[:lower:]' '[:upper:]')" in
            C)
                echo -e "\033[1;33m⚠ INSTALAÇÃO SEM LICENÇA VALIDADA (servidor offline).\033[0m"
                mkdir -p /etc/technetvpn
                echo "NAO-VALIDADA-SERVIDOR-OFFLINE-$(date '+%Y-%m-%d')" > /etc/technetvpn/licenca
                return 0
                ;;
            X)
                rm -rf $HOME/Plus >/dev/null 2>&1
                exit 1
                ;;
            *)
                validar_licenca
                return $?
                ;;
        esac
    fi

    if echo "$RESPOSTA" | grep -Eiq \
        '"(valida|valid|ok)"[[:space:]]*:[[:space:]]*true|"status"[[:space:]]*:[[:space:]]*"(valid|valida|ativa|ativo|approved|aprovado)"'; then

        mkdir -p /etc/technetvpn

        echo "$LICENCA" > /etc/technetvpn/licenca
        echo "$VPS_ID" > /etc/technetvpn/vps_id

        chmod 600 /etc/technetvpn/licenca
        chmod 600 /etc/technetvpn/vps_id

        echo ""
        echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;32m             ✅ LICENÇA VALIDADA!\033[0m"
        echo -e "\033[1;32m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo ""
        echo -e "\033[1;37mProduto: \033[1;33mPAINEL VPN\033[0m"
        echo -e "\033[1;37mLicença: \033[1;32m$LICENCA\033[0m"
        echo ""

        sleep 2

    else

        MENSAGEM=$(echo "$RESPOSTA" | sed -n 's/.*"mensagem"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

        if [[ -z "$MENSAGEM" ]]; then
            MENSAGEM=$(echo "$RESPOSTA" | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
        fi

        echo ""
        echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo -e "\033[1;31m              ❌ LICENÇA INVÁLIDA!\033[0m"
        echo -e "\033[1;31m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m"
        echo ""

        if [[ -n "$MENSAGEM" ]]; then
            echo -e "\033[1;33m$MENSAGEM\033[0m"
        else
            echo -e "\033[1;33mA licença foi recusada pelo servidor.\033[0m"
        fi

        echo ""
        echo -e "\033[1;37mCódigo informado:\033[0m $LICENCA"
        echo ""

        sleep 5

        rm -rf $HOME/Plus >/dev/null 2>&1
        exit 1
    fi
}


